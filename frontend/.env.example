# ---------------------------------------------------------------------------
# Frontend (Next.js) environment. Copy to `.env.local`.
# The backend has its own file: backend/.env (see backend/.env.example)
# ---------------------------------------------------------------------------

# Used by SERVER components (the catalogue pages). Can be an internal address
# such as http://api:4000 when both run in Docker/Kubernetes.
API_URL=http://localhost:4000

# Used by the BROWSER (the admin panel). Must be reachable from the visitor's
# machine, and must be listed in the API's CORS_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:4000
