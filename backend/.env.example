# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in real values.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=4000
# Interactive API docs at /docs. Defaults to on in development and OFF when
# NODE_ENV=production, because the page lists every admin endpoint.
# ENABLE_API_DOCS=true
# Origins allowed to call this API (comma separated). Your Next.js site.
CORS_ORIGIN=http://localhost:3000

# --- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=surgical_store

# --- Auth -------------------------------------------------------------------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Seeded admin account ---------------------------------------------------
# `npm run seed` creates this account with the password bcrypt-hashed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
